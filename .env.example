# Copiază acest fișier în .env și completează cheile din Dashboard-ul Stripe.
# Fără chei, aplicația pornește în mod demo (nu se încasează nimic).
#
# Folosește o cheie restricționată (rk_...) cu drept de scriere doar pe
# „Checkout Sessions”. Nu pune niciodată chei live în cod sau în git.
STRIPE_SECRET_KEY=rk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Din Dashboard → Developers → Webhooks (sau `stripe listen` local).
STRIPE_WEBHOOK_SECRET=whsec_...

# Adresa publică a aplicației (fără / la final). Stripe trimite donatorul aici după plată.
PUBLIC_URL=http://localhost:4242

# Opțional: linkul de autentificare în portalul clienților Stripe, ca donatorii
# lunari să-și poată anula sau modifica donația singuri.
# Dashboard → Settings → Billing → Customer portal → „Login link”.
STRIPE_PORTAL_LOGIN_URL=

PORT=4242
